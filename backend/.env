# DeepTrace Backend Configuration
# Copy to .env.local for local overrides (gitignored)

PORT=8888
ZEROTRACE_ADDR=localhost:32149
ALGORITHMS_ADDR=localhost:30290

# Uncomment to use ClickHouse directly (if deepflow-server is unavailable):
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=30815
CLICKHOUSE_DB=flow_log
CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=

# Path overrides (defaults are fine for development):
STATIC_DIR=../cloud.deepflow.yunshan.net
DATA_DIR=./data
CACHE_DIR=../api_cache
CLICKHOUSE_HTTP_PORT=31351
